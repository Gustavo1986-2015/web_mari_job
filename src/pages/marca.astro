---
// Presentación de la identidad visual (no se indexa).
import Layout from '../layouts/Layout.astro';

const colors = [
  { name: 'Azul plano', hex: '#174E8A', use: 'Portada, panel del plano' },
  { name: 'Azul noche', hex: '#0B2545', use: 'Textos y botones' },
  { name: 'Azul acento', hex: '#2F7DD1', use: 'Íconos y enlaces' },
  { name: 'Celeste', hex: '#E3EEFB', use: 'Fondos de íconos' },
  { name: 'Gris claro', hex: '#EEF3F9', use: 'Fondo de página' },
  { name: 'Ámbar', hex: '#F2A93B', use: 'Acento: luz del logo' },
];
const files = [
  'logo-horizontal-oscuro.svg',
  'logo-horizontal-claro.svg',
  'logo-horizontal-claro.png',
  'logo-horizontal-oscuro.png',
  'logo-vertical-oscuro.svg',
  'logo-vertical-claro.svg',
  'isotipo-oscuro.svg',
  'isotipo-claro.svg',
  'icono-app.svg',
  'icono-app-512.png',
];
---

<Layout title="Identidad visual | Mariana Soregaroli & Asoc." noindex>
  <main class="mx-auto max-w-6xl px-5 py-16 text-body sm:px-8 sm:py-24">
    <p class="eyebrow">Identidad visual</p>
    <h1 class="h-display mt-5 text-4xl sm:text-6xl">Mariana Soregaroli &amp; Asoc.</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-body">
      El isotipo representa las puertas de un ascensor abriéndose: el marco transmite solidez, la línea de luz ámbar
      simboliza la apertura y la resolución de cada trámite, y la flecha superior indica avance. La tipografía
      geométrica en mayúsculas espaciadas aporta seriedad y precisión técnica.
    </p>

    <section class="mt-16 grid gap-5 lg:grid-cols-2">
      <div class="grid min-h-72 place-items-center rounded-3xl blueprint p-10">
        <img src="/logo.svg" alt="Logo sobre fondo oscuro" class="w-full max-w-md" />
      </div>
      <div class="grid min-h-72 place-items-center rounded-3xl bg-white border border-line p-10">
        <img src="/logo-claro.svg" alt="Logo sobre fondo claro" class="w-full max-w-md" />
      </div>
      <div class="grid min-h-72 place-items-center rounded-3xl bg-white border border-line p-10">
        <img src="/logo-vertical-claro.svg" alt="Logo vertical" class="w-full max-w-72" />
      </div>
      <div class="grid min-h-72 grid-cols-3 place-items-center gap-6 rounded-3xl blueprint p-10">
        <img src="/isotipo.svg" alt="Isotipo" class="w-28" />
        <img src="/favicon.svg" alt="Ícono de app" class="w-20 rounded-[22%]" />
        <div class="flex flex-col items-center gap-4">
          <img src="/favicon.svg" alt="" class="w-8" />
          <img src="/favicon.svg" alt="" class="w-4" />
        </div>
      </div>
    </section>

    <h2 class="mt-20 font-display text-2xl font-semibold text-ink">Colores</h2>
    <ul class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
      {
        colors.map((c) => (
          <li class="overflow-hidden rounded-2xl border border-line bg-white">
            <div class="h-24" style={`background:${c.hex}`} />
            <div class="p-4">
              <p class="font-display font-semibold text-ink">{c.name}</p>
              <p class="font-mono text-xs text-body">{c.hex}</p>
              <p class="mt-1 text-xs text-muted">{c.use}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <h2 class="mt-20 font-display text-2xl font-semibold text-ink">Tipografía</h2>
    <div class="mt-6 grid gap-5 md:grid-cols-2">
      <div class="rounded-2xl border border-line bg-white p-8">
        <p class="text-xs text-muted">Títulos y logo — Space Grotesk</p>
        <p class="mt-4 font-display text-5xl font-semibold text-ink">Aa Bb 0123</p>
      </div>
      <div class="rounded-2xl border border-line bg-white p-8">
        <p class="text-xs text-muted">Textos — Inter</p>
        <p class="mt-4 text-5xl font-medium text-ink">Aa Bb 0123</p>
      </div>
    </div>

    <h2 class="mt-20 font-display text-2xl font-semibold text-ink">Archivos</h2>
    <p class="mt-2 text-sm text-muted">Carpeta <code class="text-ink">/brand</code> del proyecto.</p>
    <ul class="mt-4 flex flex-wrap gap-2 text-sm">
      {files.map((f) => <li class="rounded-full border border-line px-3 py-1.5 text-body">{f}</li>)}
    </ul>

    <a href="/" class="btn-primary mt-16">← Volver al sitio</a>
  </main>
</Layout>
