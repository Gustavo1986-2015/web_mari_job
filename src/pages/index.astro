---
import Layout from '../layouts/Layout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import Servicios from '../components/sections/Servicios.astro';
import Gestoria from '../components/sections/Gestoria.astro';
import Nosotros from '../components/sections/Nosotros.astro';
import Informacion from '../components/sections/Informacion.astro';
import Contacto from '../components/sections/Contacto.astro';
---

<Layout>
  <!-- La portada incluye el header y la lámina del plano con el ascensor 3D -->
  <Hero />
  <main class="lg:pr-[calc(var(--panel-w)+12px)]">
    <Gestoria />
    <Servicios />
    <Nosotros />
    <Informacion />
    <Contacto />
  </main>
  <Footer />
  <WhatsAppButton />
</Layout>

<script>
  import '../scripts/interactions';
</script>
