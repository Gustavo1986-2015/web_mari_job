---
import { Menu, X, Phone } from '@lucide/astro';
import { site } from '../config/site';

const links = [
  { href: '#servicios', label: 'Servicios' },
  { href: '#gestoria', label: 'Gestoría' },
  { href: '#nosotros', label: 'Nosotros' },
  { href: '#contacto', label: 'Contacto' },
];
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-[background,border-color,backdrop-filter] duration-500 border-b border-transparent data-[scrolled]:border-line data-[scrolled]:bg-ink/70 data-[scrolled]:backdrop-blur-xl"
>
  <div class="mx-auto flex h-18 max-w-7xl items-center justify-between gap-6 px-5 sm:px-8">
    <a href="#inicio" class="shrink-0" aria-label={`${site.name} — inicio`}>
      <img src="/logo.svg" alt={site.name} width="205" height="38" class="h-8 w-auto sm:h-9" />
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Principal">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="rounded-full px-4 py-2 text-sm text-steel-2 transition hover:bg-white/5 hover:text-white"
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <span
        class="flex h-11 min-w-12 items-center justify-center gap-1 rounded-full border border-white/10 bg-[#050608] px-3 font-display text-sm font-semibold text-amber [text-shadow:0_0_10px_rgb(242_169_59/0.6)] xl:hidden"
        aria-hidden="true"
      >
        <span data-floor-arrow class="text-[9px] opacity-0 transition-opacity">▲</span>
        <span data-floor-display>PB</span>
      </span>
      <a href={site.phone.href} class="hidden items-center gap-2 px-3 text-sm text-steel-2 transition hover:text-white xl:flex">
        <Phone size={16} class="text-amber" />
        {site.phone.display}
      </a>
      <a href="#contacto" class="btn-primary hidden !py-2.5 sm:inline-flex">Pedir cotización</a>
      <button
        id="menu-toggle"
        type="button"
        class="grid size-11 place-items-center rounded-full border border-white/10 text-steel lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú"
      >
        <Menu size={20} class="menu-open" />
        <X size={20} class="menu-close hidden" />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-line bg-ink/95 backdrop-blur-xl lg:hidden">
    <nav class="mx-auto flex max-w-7xl flex-col px-5 py-4" aria-label="Móvil">
      {
        links.map((l) => (
          <a href={l.href} class="border-b border-line py-4 font-display text-lg text-white last:border-0">
            {l.label}
          </a>
        ))
      }
      <a href="#contacto" class="btn-primary mt-4">Pedir cotización</a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;

  const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    menu.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    toggle.querySelector('.menu-open')!.classList.toggle('hidden', open);
    toggle.querySelector('.menu-close')!.classList.toggle('hidden', !open);
    if (open) header.setAttribute('data-scrolled', '');
    else onScroll();
  };
  toggle.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>
