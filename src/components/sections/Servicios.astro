---
import Section from '../Section.astro';
import SectionHeading from '../SectionHeading.astro';
import Icon from '../Icon.astro';
import { technicalServices } from '../../config/site';
---

<Section id="servicios" floor={2}>
  <SectionHeading floor="2" eyebrow="Servicios técnicos" title="Ingeniería y documentación para cada etapa de su ascensor.">
    Desde la adecuación normativa hasta la modernización, respaldamos técnicamente cada instalación.
  </SectionHeading>

  <ul class="mt-14 grid gap-4 sm:grid-cols-2" data-reveal-group>
    {
      technicalServices.map((s, i) => (
        <li class="card card-hover p-7" data-reveal>
          <div class="flex items-start justify-between">
            <span class="icon-tile size-12">
              <Icon name={s.icon} />
            </span>
            <span class="font-display text-xs text-muted/70">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <h3 class="mt-6 font-display text-lg font-semibold text-ink">{s.title}</h3>
          <p class="mt-2 text-[15px] leading-relaxed text-body">{s.text}</p>
        </li>
      ))
    }
  </ul>
</Section>
