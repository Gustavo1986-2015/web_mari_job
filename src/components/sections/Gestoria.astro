---
import {
  QrCode,
  BookOpenCheck,
  House,
  FileStack,
  ArrowLeftRight,
  IdCard,
  LockOpen,
  TriangleAlert,
  ArrowRight,
} from '@lucide/astro';
import SectionHeading from '../SectionHeading.astro';

const items = [
  { icon: BookOpenCheck, title: 'Libro Digital de Inspección' },
  { icon: House, title: 'Informe de Dominio del inmueble' },
  { icon: FileStack, title: 'Duplicado de Expediente de Habilitación' },
  { icon: ArrowLeftRight, title: 'Transferencia de Titularidad de Habilitación' },
  { icon: IdCard, title: 'Renovación del Permiso de Conservador' },
  { icon: LockOpen, title: 'Levantamiento de Clausuras' },
];
---

<section id="gestoria" data-floor="2" class="relative scroll-mt-20 py-28 sm:py-36">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="max-w-[680px]">
      <SectionHeading floor="2" eyebrow="Gestoría ante el G.C.B.A." title="Todos los trámites de su edificio, en un solo lugar.">
        Conocemos cada paso administrativo. Presentamos, seguimos y resolvemos los trámites para que usted no pierda tiempo.
      </SectionHeading>

      <!-- Trámite destacado -->
      <article class="card card-glow mt-14 p-7 sm:p-9" data-reveal>
        <div class="pointer-events-none absolute -top-24 -right-24 size-72 rounded-full bg-amber/15 blur-3xl"></div>
        <div class="relative flex flex-col gap-7 sm:flex-row sm:items-center">
          <div class="grid size-24 shrink-0 place-items-center rounded-2xl border border-amber/30 bg-[#050608] text-amber shadow-[0_0_40px_-8px_rgb(242_169_59/0.5)]">
            <QrCode size={48} stroke-width={1.4} />
          </div>
          <div>
            <p class="font-display text-xs font-medium tracking-[0.2em] text-amber uppercase">Resolución N.º 430</p>
            <h3 class="mt-2 font-display text-2xl font-semibold text-white sm:text-3xl">Obleas Código QR</h3>
            <p class="mt-3 leading-relaxed text-steel-2">
              Gestionamos la oblea obligatoria para cada instalación del edificio.
            </p>
            <ul class="mt-4 flex flex-wrap gap-2 text-sm">
              {['Ascensores', 'Instalaciones térmicas', 'Incendio'].map((t) => (
                <li class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 text-steel">{t}</li>
              ))}
            </ul>
          </div>
        </div>
      </article>

      <ul class="mt-4 grid gap-3 sm:grid-cols-2" data-reveal-group>
        {
          items.map((it) => (
            <li class="card card-glow flex items-center gap-4 p-4 pr-5 transition duration-500 hover:border-white/15" data-reveal>
              <span class="grid size-11 shrink-0 place-items-center rounded-lg bg-white/[0.05] text-amber">
                <it.icon size={20} stroke-width={1.6} />
              </span>
              <span class="text-[15px] leading-snug font-medium text-steel">{it.title}</span>
            </li>
          ))
        }
      </ul>

      <!-- Evite multas -->
      <aside
        class="mt-8 flex flex-col gap-5 rounded-2xl border border-amber/30 bg-gradient-to-r from-amber/[0.12] to-amber/[0.02] p-6 sm:flex-row sm:items-center sm:p-7"
        data-reveal
      >
        <span class="grid size-12 shrink-0 place-items-center rounded-full bg-amber text-ink">
          <TriangleAlert size={22} stroke-width={2} />
        </span>
        <div class="flex-1">
          <p class="font-display text-xl font-semibold text-white">Evite multas y clausuras</p>
          <p class="mt-1 text-[15px] leading-relaxed text-steel-2">
            Mantener la documentación de los ascensores al día es una obligación del edificio. Consúltenos y revisamos su situación.
          </p>
        </div>
        <a href="#contacto" class="btn-primary shrink-0 !px-5">
          Consultar <ArrowRight size={16} />
        </a>
      </aside>
    </div>
  </div>
</section>
