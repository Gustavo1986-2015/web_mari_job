---
import { ArrowRight, ArrowDown } from '@lucide/astro';
import Header from '../Header.astro';
import Stage from '../Stage.astro';
import WhatsAppIcon from '../WhatsAppIcon.astro';
import { site, whatsappUrl } from '../../config/site';

const trust = [
  { value: `+${site.years}`, label: 'años de experiencia' },
  { value: 'G.C.B.A.', label: 'gestiones y trámites' },
  { value: 'Res. 430', label: 'Oblea QR al día' },
];
---

<section
  id="inicio"
  data-floor="0"
  class="blueprint sheet-frame relative m-2 flex min-h-[calc(100svh-16px)] flex-col overflow-hidden rounded-[24px] sm:m-3 sm:min-h-[calc(100svh-24px)] sm:rounded-[28px]"
>
  <Header />
  <Stage />

  <div class="relative z-10 flex flex-1 items-center pb-[48svh] lg:w-[calc(100%-var(--panel-w))] lg:pb-0">
    <div class="w-full px-6 pt-6 pb-10 sm:px-10 lg:py-16 xl:px-16">
      <p class="eyebrow !text-white/85" data-hero><span>Estudio técnico de ascensores<span class="hidden sm:inline"> · CABA</span></span></p>

      <h1
        class="mt-6 font-display text-[2.3rem] leading-[1.05] font-semibold tracking-tight text-balance text-white sm:text-[3.4rem] xl:text-[4.1rem]"
        data-hero-title
      >
        Su ascensor en regla, de acuerdo a la <span class="text-amber-soft">normativa vigente</span> y sin multas.
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/80" data-hero>
        Más de {site.years} años gestionando habilitaciones, Obleas QR y trámites técnicos ante el Gobierno de la Ciudad
        de Buenos Aires. Nos ocupamos de todo para que su edificio cumpla con la normativa.
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row" data-hero>
        <a href="#contacto" class="btn-white group">
          Pedir cotización
          <ArrowRight size={18} class="transition-transform group-hover:translate-x-1" />
        </a>
        <a href={whatsappUrl()} target="_blank" rel="noopener" class="btn-outline-white">
          <WhatsAppIcon size={18} />
          Consultar por WhatsApp
        </a>
      </div>

      <dl class="mt-12 grid max-w-xl grid-cols-3 divide-x divide-white/20 border-y border-white/20" data-hero>
        {
          trust.map((t) => (
            <div class="flex flex-col-reverse py-5 pr-3 pl-4 first:pl-0">
              <dt class="mt-1 text-xs leading-snug text-white/65 sm:text-sm">{t.label}</dt>
              <dd class="font-display text-lg font-semibold whitespace-nowrap text-white sm:text-2xl">{t.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>

  <a
    href="#gestoria"
    class="absolute bottom-6 left-1/2 z-10 hidden -translate-x-1/2 flex-col items-center gap-1 rounded-full bg-white px-5 py-3 text-xs font-semibold text-ink shadow-lg transition hover:-translate-y-0.5 lg:flex [@media(max-height:960px)]:!hidden lg:left-[calc((100%-var(--panel-w))/2)]"
    data-hero
  >
    Bajar
    <ArrowDown size={14} class="animate-bounce" />
  </a>
</section>
