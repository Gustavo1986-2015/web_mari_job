---
import { ArrowRight } from '@lucide/astro';
import WhatsAppIcon from '../WhatsAppIcon.astro';
import { site, whatsappUrl } from '../../config/site';

const trust = [
  { value: `+${site.years}`, label: 'años de experiencia' },
  { value: 'G.C.B.A.', label: 'gestiones y trámites' },
  { value: 'Res. 430', label: 'Oblea QR al día' },
];
---

<section id="inicio" data-floor="0" class="relative flex min-h-svh items-center pt-24 pb-20">
  <div class="mx-auto w-full max-w-7xl px-5 sm:px-8">
    <div class="max-w-[640px] xl:max-w-[680px]">
      <p class="eyebrow" data-hero>Estudio técnico de ascensores · CABA</p>

      <h1 class="h-display mt-7 text-[2.6rem] leading-[1.02] sm:text-6xl lg:text-7xl" data-hero-title>
        Su ascensor en regla, <span class="text-amber">sin demoras</span> ni multas.
      </h1>

      <p class="mt-7 max-w-xl text-lg leading-relaxed text-steel-2" data-hero>
        Más de {site.years} años gestionando habilitaciones, Obleas QR y trámites técnicos ante el
        Gobierno de la Ciudad de Buenos Aires. Nos ocupamos de todo para que su edificio cumpla con la
        normativa.
      </p>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row" data-hero>
        <a href="#contacto" class="btn-primary group">
          Pedir cotización
          <ArrowRight size={18} class="transition-transform group-hover:translate-x-1" />
        </a>
        <a href={whatsappUrl()} target="_blank" rel="noopener" class="btn-ghost">
          <WhatsAppIcon size={18} class="text-[#25D366]" />
          Consultar por WhatsApp
        </a>
      </div>

      <dl class="mt-14 grid max-w-xl grid-cols-3 divide-x divide-line border-y border-line" data-hero>
        {
          trust.map((t) => (
            <div class="py-5 pr-3 pl-4 first:pl-0">
              <dt class="font-display text-xl font-semibold text-white sm:text-2xl">{t.value}</dt>
              <dd class="mt-1 text-xs leading-snug text-muted sm:text-sm">{t.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>

  <a
    href="#servicios"
    class="absolute bottom-8 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-3 text-[11px] tracking-[0.25em] text-muted uppercase transition hover:text-white md:flex lg:left-8 lg:translate-x-0 xl:left-[max(2rem,calc((100vw-80rem)/2+2rem))]"
    data-hero
  >
    <span class="relative h-11 w-6 rounded-full border border-white/20">
      <span class="absolute top-2 left-1/2 h-2 w-0.5 -translate-x-1/2 animate-bounce rounded-full bg-amber"></span>
    </span>
    Suba con nosotros
  </a>
</section>
