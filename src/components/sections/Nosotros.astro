---
import { BuildingComplex, Wrench, HardHat, Landmark, Factory } from '@lucide/astro';
import SectionHeading from '../SectionHeading.astro';
import { site } from '../../config/site';

const audiences = [
  { icon: BuildingComplex, title: 'Administradores de consorcios' },
  { icon: Wrench, title: 'Empresas de mantenimiento e instalación de ascensores' },
  { icon: HardHat, title: 'Empresas constructoras y desarrolladoras' },
  { icon: Landmark, title: 'Edificios de oficinas públicas y privadas' },
  { icon: Factory, title: 'Fábricas y depósitos' },
];

const steps = [
  { title: 'Consulta', text: 'Nos cuenta qué necesita por teléfono, WhatsApp o el formulario.' },
  { title: 'Cotización', text: 'Le enviamos un presupuesto claro y detallado.' },
  { title: 'Gestión', text: 'Realizamos el trámite ante el G.C.B.A. y lo mantenemos informado.' },
  { title: 'Entrega', text: 'Recibe la documentación aprobada de su instalación.' },
];
---

<section id="nosotros" data-floor="3" class="relative scroll-mt-20 py-28 sm:py-36">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="max-w-[680px]">
      <SectionHeading floor="3" eyebrow="Nuestro equipo" title={`${site.years} años de experiencia respaldan cada gestión.`}>
        Somos un grupo de profesionales asociados que ofrece sus servicios y gestiones ante el Gobierno de la
        Ciudad de Buenos Aires, con el conocimiento que solo dan cuatro décadas en el rubro.
      </SectionHeading>

      <dl class="mt-12 grid grid-cols-3 gap-3" data-reveal-group>
        <div class="card flex flex-col-reverse p-5 sm:p-6" data-reveal>
          <dt class="mt-2 text-xs text-muted sm:text-sm">Años de experiencia</dt>
          <dd class="font-display text-3xl font-semibold text-white sm:text-5xl">
            +<span data-count={site.years}>{site.years}</span>
          </dd>
        </div>
        <div class="card flex flex-col-reverse p-5 sm:p-6" data-reveal>
          <dt class="mt-2 text-xs text-muted sm:text-sm">Servicios y trámites</dt>
          <dd class="font-display text-3xl font-semibold text-white sm:text-5xl"><span data-count="13">13</span></dd>
        </div>
        <div class="card flex flex-col-reverse p-5 sm:p-6" data-reveal>
          <dt class="mt-2 text-xs text-muted sm:text-sm">Zona de cobertura</dt>
          <dd class="font-display text-3xl font-semibold text-amber sm:text-5xl">CABA</dd>
        </div>
      </dl>

      <h3 class="mt-16 font-display text-sm font-medium tracking-[0.2em] text-muted uppercase" data-reveal>
        Trabajamos para
      </h3>
      <ul class="mt-5 divide-y divide-line border-y border-line" data-reveal-group>
        {
          audiences.map((a) => (
            <li class="group flex items-center gap-5 py-4" data-reveal>
              <span class="grid size-10 shrink-0 place-items-center rounded-lg border border-white/10 text-steel-2 transition group-hover:border-amber/50 group-hover:text-amber">
                <a.icon size={19} stroke-width={1.6} />
              </span>
              <span class="text-base text-steel transition group-hover:text-white sm:text-lg">{a.title}</span>
            </li>
          ))
        }
      </ul>

      <h3 class="mt-16 font-display text-sm font-medium tracking-[0.2em] text-muted uppercase" data-reveal>
        Cómo trabajamos
      </h3>
      <ol class="relative mt-6 grid gap-4 sm:grid-cols-2" data-reveal-group>
        {
          steps.map((s, i) => (
            <li class="card p-6" data-reveal>
              <span class="font-display text-sm font-semibold text-amber">Paso {i + 1}</span>
              <p class="mt-3 font-display text-lg font-semibold text-white">{s.title}</p>
              <p class="mt-1.5 text-[15px] leading-relaxed text-steel-2">{s.text}</p>
            </li>
          ))
        }
      </ol>

      <!-- Espacio reservado para logos de clientes (pendiente de recibir). -->
    </div>
  </div>
</section>
