---
import { BuildingComplex, Wrench, HardHat, Landmark, Factory } from '@lucide/astro';
import Section from '../Section.astro';
import SectionHeading from '../SectionHeading.astro';
import { site, totalServices } from '../../config/site';

const audiences = [
  { icon: BuildingComplex, title: 'Administradores de consorcios' },
  { icon: Wrench, title: 'Empresas de mantenimiento e instalación de ascensores' },
  { icon: HardHat, title: 'Empresas constructoras y desarrolladoras' },
  { icon: Landmark, title: 'Edificios de oficinas públicas y privadas' },
  { icon: Factory, title: 'Fábricas y depósitos' },
];

const steps = [
  { title: 'Consulta', text: 'Nos cuenta qué necesita por teléfono, WhatsApp o el formulario.' },
  { title: 'Cotización', text: 'Le enviamos un presupuesto claro y detallado.' },
  { title: 'Gestión', text: 'Realizamos el trámite ante el G.C.B.A. y lo mantenemos informado.' },
  { title: 'Entrega', text: 'Recibe la documentación aprobada de su instalación.' },
];

const stats = [
  { value: `+${site.years}`, count: site.years, prefix: '+', label: 'Años de experiencia' },
  { value: String(totalServices), count: totalServices, prefix: '', label: 'Servicios y trámites' },
  { value: 'CABA', label: 'Zona de cobertura' },
];
---

<Section id="nosotros" floor={3}>
  <SectionHeading floor="3" eyebrow="Nuestro equipo" title={`Más de ${site.years} años de experiencia respaldan cada gestión.`}>
    Somos un grupo de profesionales asociados que ofrece sus servicios y gestiones ante el Gobierno de la Ciudad de
    Buenos Aires, con conocimiento técnico y administrativo de cada trámite.
  </SectionHeading>

  <dl class="mt-12 grid grid-cols-3 gap-3" data-reveal-group>
    {
      stats.map((s, i) => (
        <div class:list={['flex flex-col-reverse rounded-3xl p-5 sm:p-6', i === 0 ? 'blueprint text-white' : 'card']} data-reveal>
          <dt class:list={['mt-2 text-xs sm:text-sm', i === 0 ? 'text-white/75' : 'text-muted']}>{s.label}</dt>
          <dd class:list={['font-display text-3xl font-semibold sm:text-5xl', i === 0 ? 'text-white' : i === 2 ? 'text-bp-600' : 'text-ink']}>
            {s.count ? (
              <>
                {s.prefix}
                <span data-count={s.count}>{s.count}</span>
              </>
            ) : (
              s.value
            )}
          </dd>
        </div>
      ))
    }
  </dl>

  <h3 class="mt-16 font-display text-sm font-semibold tracking-[0.2em] text-muted uppercase" data-reveal>Trabajamos para</h3>
  <ul class="card mt-5 divide-y divide-line" data-reveal-group>
    {
      audiences.map((a) => (
        <li class="group flex items-center gap-5 px-5 py-4 sm:px-6" data-reveal>
          <span class="icon-tile size-10 rounded-xl transition group-hover:bg-bp-600 group-hover:text-white">
            <a.icon size={19} stroke-width={1.7} />
          </span>
          <span class="text-base text-ink sm:text-lg">{a.title}</span>
        </li>
      ))
    }
  </ul>

  <h3 class="mt-16 font-display text-sm font-semibold tracking-[0.2em] text-muted uppercase" data-reveal>Cómo trabajamos</h3>
  <ol class="mt-5 grid gap-3 sm:grid-cols-2" data-reveal-group>
    {
      steps.map((s, i) => (
        <li class="card p-6" data-reveal>
          <span class="grid size-9 place-items-center rounded-full border border-bp-200 font-display text-sm font-semibold text-bp-600">
            {i + 1}
          </span>
          <p class="mt-4 font-display text-lg font-semibold text-ink">{s.title}</p>
          <p class="mt-1.5 text-[15px] leading-relaxed text-body">{s.text}</p>
        </li>
      ))
    }
  </ol>

  <!-- Espacio reservado para logos de clientes (pendiente de recibir). -->
</Section>
