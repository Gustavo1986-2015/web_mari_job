---
import WhatsAppIcon from './WhatsAppIcon.astro';
import { whatsappUrl } from '../config/site';
---

<a
  href={whatsappUrl()}
  target="_blank"
  rel="noopener"
  class="group fixed right-4 bottom-5 z-40 flex items-center gap-3 rounded-full bg-[#25D366] p-3.5 text-white shadow-[0_12px_40px_-8px_rgb(37_211_102/0.6)] transition duration-300 hover:-translate-y-0.5 hover:bg-[#1fbe5b] sm:right-6 sm:bottom-6"
  aria-label="Escríbanos por WhatsApp"
>
  <WhatsAppIcon size={26} />
  <span class="hidden pr-1 text-sm font-semibold sm:inline">WhatsApp</span>
</a>
