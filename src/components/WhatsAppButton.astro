---
import WhatsAppIcon from './WhatsAppIcon.astro';
import { whatsappUrl } from '../config/site';
---

<a
  href={whatsappUrl()}
  target="_blank"
  rel="noopener"
  class="fixed right-4 bottom-4 z-40 grid size-14 place-items-center rounded-full bg-[#25D366] text-white shadow-[0_12px_32px_-8px_rgb(18_140_126/0.55)] transition duration-300 hover:-translate-y-0.5 hover:bg-[#1fbe5b] sm:right-6 sm:bottom-6 lg:right-[calc(var(--panel-w)+36px)]"
  aria-label="Escríbanos por WhatsApp"
>
  <WhatsAppIcon size={26} />
</a>
