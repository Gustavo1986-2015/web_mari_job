---
import { siWhatsapp } from 'simple-icons';
interface Props {
  size?: number;
  class?: string;
}
const { size = 24, class: className } = Astro.props;
---

<svg viewBox="0 0 24 24" width={size} height={size} fill="currentColor" aria-hidden="true" class={className}>
  <path d={siWhatsapp.path} />
</svg>
