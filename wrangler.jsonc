// Publicación en Cloudflare Workers como sitio estático (sin servidor ni adaptador).
// El build de Astro genera /dist y Cloudflare lo sirve tal cual, incluidos los _headers.
{
  "name": "estudiomarianasoregaroli",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": false
}
